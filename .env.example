PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
STRIPE_MODE=test
STRIPE_LIVE_MODE_APPROVED=false

# Optional legacy redirect; only Stripe test-mode Payment Links are accepted.
STRIPE_PAYMENT_LINK_URL=

# Stripe secret key and webhook signing secret for the selected mode. Keep both server-side.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo API key and contact list ID.
BREVO_API_KEY=
BREVO_LIST_ID=4

# Fourthwall public Storefront API token. Keep it server-side in .env or host secrets.
FOURTHWALL_STOREFRONT_TOKEN=

# Durable school ledger: PostgreSQL connection URI (Render internal URL on Render).
# For external PostgreSQL use the provider's verified TLS connection settings.
DATABASE_URL=
# Separate school live-payment gate: enable only after test payments pass and Logan approves.
SCHOOL_LIVE_PAYMENTS_APPROVED=false
# Generate with: node scripts/admin-password.js
SCHOOL_ADMIN_PASSWORD_HASH=
# Brevo verified sender and the private recipient for school donation notices.
SCHOOL_NOTIFICATION_FROM=
SCHOOL_NOTIFICATION_TO=
