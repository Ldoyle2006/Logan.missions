PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
STRIPE_MODE=test
STRIPE_LIVE_MODE_APPROVED=false

# Optional legacy redirect; only Stripe test-mode Payment Links are accepted.
STRIPE_PAYMENT_LINK_URL=

# Stripe secret key and webhook signing secret for the selected mode. Keep both server-side.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo API key and contact list ID.
BREVO_API_KEY=
BREVO_LIST_ID=4

# Fourthwall public Storefront API token. Keep it server-side in .env or host secrets.
FOURTHWALL_STOREFRONT_TOKEN=
