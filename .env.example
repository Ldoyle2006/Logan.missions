PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Optional legacy redirect; only Stripe test-mode Payment Links are accepted.
STRIPE_PAYMENT_LINK_URL=

# Stripe test-mode keys and webhook signing secret. Keep secret values server-side;
# only the publishable key is returned to Stripe.js by the server.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo API key and contact list ID.
BREVO_API_KEY=
BREVO_LIST_ID=4
