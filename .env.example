PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Paste a Stripe Payment Link URL from your Stripe dashboard.
STRIPE_PAYMENT_LINK_URL=

# Stripe secret key for server-created, amount-specific Checkout sessions.
# Keep this key in server environment settings only; never use a publishable key here.
STRIPE_SECRET_KEY=

# Brevo API key and contact list ID.
BREVO_API_KEY=
BREVO_LIST_ID=4
