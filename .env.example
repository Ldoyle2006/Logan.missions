PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
STRIPE_MODE=test
STRIPE_LIVE_MODE_APPROVED=false

# Optional legacy redirect; only Stripe test-mode Payment Links are accepted.
STRIPE_PAYMENT_LINK_URL=

# Stripe keys and webhook signing secret for the selected mode. Keep secrets server-side;
# only the publishable key is returned to Stripe.js by the server.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo API key and contact list ID.
BREVO_API_KEY=
BREVO_LIST_ID=4
